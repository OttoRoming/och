# name "cmake"
# version "4.1.0"
# description "de-facto standard for building C++ code, with over 2 million downloads a month"
# url "https://cmake.org/"
# source tar "https://cmake.org/files/v4.1/cmake-4.1.0.tar.gz"
# runtime "curl" "libarchive" "libuv" "nghttp2"
# build "python-sphinx"
# ---

cd cmake-4.1.0

sed -i '/"lib64"/s/64//' Modules/GNUInstallDirs.cmake &&

./bootstrap --prefix=/usr        \
            --system-libs        \
            --mandir=/share/man  \
            --sphinx-man         \
            --sphinx-html        \
            --no-system-jsoncpp  \
            --no-system-cppdap   \
            --no-system-librhash \
            --docdir=/share/doc/cmake-4.1.0
make

make install
