# name "docbook-xsl-nons"
# version "1.79.2"
# description "docbook xsl non-standard stylesheets"
# url "https://docbook.org/"
# source tar "https://github.com/docbook/xslt10-stylesheets/releases/download/release/1.79.2/docbook-xsl-nons-1.79.2.tar.bz2"
# source get "https://www.linuxfromscratch.org/patches/blfs/12.4/docbook-xsl-nons-1.79.2-stack_fix-1.patch"
# source get "https://github.com/docbook/xslt10-stylesheets/releases/download/release/1.79.2/docbook-xsl-doc-1.79.2.tar.bz2"
# runtime "libxml2"
# ---

# First, fix a problem that causes stack overflows when doing recursion:
patch -Np1 -i ../docbook-xsl-nons-1.79.2-stack_fix-1.patch

# Extract the documentation
tar -xf ../docbook-xsl-doc-1.79.2.tar.bz2 --strip-components=1

# Install DocBook XSL Stylesheets by running the following commands:
install -v -m755 -d ${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2 &&

cp -v -R VERSION assembly common eclipse epub epub3 extensions fo        \
         highlighting html htmlhelp images javahelp lib manpages params  \
         profiling roundtrip slides template tests tools webhelp website \
         xhtml xhtml-1_1 xhtml5                                          \
    ${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2 &&

ln -s VERSION ${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2/VERSION.xsl &&

install -v -m644 -D README \
                    ${DESTDIR}/usr/share/doc/docbook-xsl-nons-1.79.2/README.txt &&

install -v -m644    RELEASE-NOTES* NEWS* \
                    ${DESTDIR}/usr/share/doc/docbook-xsl-nons-1.79.2

# If you downloaded the optional documentation tarball, install the documentation by issuing:
cp -v -R doc/* ${DESTDIR}/usr/share/doc/docbook-xsl-nons-1.79.2

# Create (or append) and populate the XML catalog file using the following commands (both http and https forms are used because upstream have had both in their documentation):

if [ ! -d ${DESTDIR}/etc/xml ]; then install -v -m755 -d ${DESTDIR}/etc/xml; fi &&
if [ ! -f ${DESTDIR}/etc/xml/catalog ]; then
    xmlcatalog --noout --create ${DESTDIR}/etc/xml/catalog
fi &&

xmlcatalog --noout --add "rewriteSystem"                        \
           "http://cdn.docbook.org/release/xsl-nons/1.79.2"     \
           "${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
           ${DESTDIR}/etc/xml/catalog &&

xmlcatalog --noout --add "rewriteSystem"                        \
           "https://cdn.docbook.org/release/xsl-nons/1.79.2"    \
           "${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
           ${DESTDIR}/etc/xml/catalog &&

xmlcatalog --noout --add "rewriteURI"                           \
           "http://cdn.docbook.org/release/xsl-nons/1.79.2"     \
           "${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
           ${DESTDIR}/etc/xml/catalog &&

xmlcatalog --noout --add "rewriteURI"                           \
           "https://cdn.docbook.org/release/xsl-nons/1.79.2"    \
           "${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
           ${DESTDIR}/etc/xml/catalog &&

xmlcatalog --noout --add "rewriteSystem"                        \
           "http://cdn.docbook.org/release/xsl-nons/current"    \
           "${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
           ${DESTDIR}/etc/xml/catalog &&

xmlcatalog --noout --add "rewriteSystem"                        \
           "https://cdn.docbook.org/release/xsl-nons/current"   \
           "${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
           ${DESTDIR}/etc/xml/catalog &&

xmlcatalog --noout --add "rewriteURI"                           \
           "http://cdn.docbook.org/release/xsl-nons/current"    \
           "${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
           ${DESTDIR}/etc/xml/catalog &&

xmlcatalog --noout --add "rewriteURI"                           \
           "https://cdn.docbook.org/release/xsl-nons/current"   \
           "${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
           ${DESTDIR}/etc/xml/catalog &&

xmlcatalog --noout --add "rewriteSystem"                        \
           "http://docbook.sourceforge.net/release/xsl/current" \
           "${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
           ${DESTDIR}/etc/xml/catalog &&

xmlcatalog --noout --add "rewriteURI"                           \
           "http://docbook.sourceforge.net/release/xsl/current" \
           "${DESTDIR}/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
           ${DESTDIR}/etc/xml/catalog
