# name "doxygen"
# version "1.14.0"
# description "widely-used documentation generator tool in software development"
# url "https://www.doxygen.nl/index.html"
# source tar "https://doxygen.nl/files/doxygen-1.14.0.src.tar.gz"
# build "cmake" "git"
# ---

# FIXME: doxygen documentation is not generated

cd doxygen-1.14.0

grep -rl '^#!.*python$' | xargs sed -i '1s/python/&3/'

mkdir -v build
cd       build

cmake -G "Unix Makefiles"          \
      -D CMAKE_BUILD_TYPE=Release  \
      -D CMAKE_INSTALL_PREFIX=/usr \
      -D build_wizard=ON           \
      -D force_qt=Qt6              \
      -W no-dev ..
make

make install
install -vm644 ../doc/*.1 /usr/share/man/man1
