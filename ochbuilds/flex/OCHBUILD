# name "flex"
# version "2.6.4"
# description "Utility for generating programs that recognize patterns in text."
# url "https://github.com/westes/flex"
# source tar "https://github.com/westes/flex/releases/download/v2.6.4/flex-2.6.4.tar.gz"
# ---

cd flex-2.6.4

./configure --prefix=/usr \
            --docdir=/usr/share/doc/flex-2.6.4 \
            --disable-static

make
make install

# A few programs do not know about flex yet and try to run its predecessor, lex.
# To support those programs, create a symbolic link named lex that runs flex in lex emulation mode,
# and also create the man page of lex as a symlink
ln -sv flex   "$DESTDIR/usr/bin/lex"
ln -sv flex.1 "$DESTDIR/usr/share/man/man1/lex.1"
