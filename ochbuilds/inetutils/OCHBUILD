# name "inetutils"
# version "2.6"
# description "programs for basic networking"
# url "https://www.gnu.org/software/inetutils/"
# source tar "https://ftp.gnu.org/gnu/inetutils/inetutils-2.6.tar.xz"
# ---

cd inetutils-2.6

sed -i 's/def HAVE_TERMCAP_TGETENT/ 1/' telnet/telnet.c

./configure --prefix=/usr        \
            --bindir=/usr/bin    \
            --localstatedir=/var \
            --disable-logger     \
            --disable-whois      \
            --disable-rcp        \
            --disable-rexec      \
            --disable-rlogin     \
            --disable-rsh        \
            --disable-servers

make
make install

mv -v "$DESTDIR/usr/{,s}bin/ifconfig"
