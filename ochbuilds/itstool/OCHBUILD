# name "itstool"
# version "2.0.7"
# description "allows you to translate your XML documents with PO files, using rules from the W3C Internationalization Tag Set (ITS) to determine what to translate and how to separate it into PO file messages."
# url "https://itstool.org/"
# source tar "https://files.itstool.org/itstool/itstool-2.0.7.tar.bz2"
# runtime "docbook-xml"
# ---

cd itstool-2.0.7

sed -i 's/re.sub(/re.sub(r/'         itstool.in &&
sed -i 's/re.compile(/re.compile(r/' itstool.in

PYTHON=/usr/bin/python3 ./configure --prefix=/usr &&
make

make install
