# name "kbd"
# version "2.8.0"
# description "key-table files, console fonts, and keyboard utilities"
# url "https://kbd-project.org/"
# source tar "https://www.kernel.org/pub/linux/utils/kbd/kbd-2.8.0.tar.xz"
# source get "https://www.linuxfromscratch.org/patches/lfs/12.4/kbd-2.8.0-backspace-1.patch"
# ---

patch -Np1 -i ../kbd-2.8.0-backspace-1.patch

sed -i '/RESIZECONS_PROGS=/s/yes/no/' configure
sed -i 's/resizecons.8 //' docs/man/man8/Makefile.in

./configure --prefix=/usr --disable-vlock

make
make install

cp -R -v docs/doc -T "$DESTDIR/usr/share/doc/kbd-2.8.0"
