# name "libxml2"
# version "2.14.5"
# description "the XML C parser and toolkit developed for the GNOME project"
# url "https://gitlab.gnome.org/GNOME/libxml2/-/wikis/home"
# source tar "https://github.com/libarchive/libarchive/releases/download/v3.8.1/libarchive-3.8.1.tar.xz"
# runtime "icu"
# ---

cd libxml2-2.14.5

./configure --prefix=/usr     \
            --sysconfdir=/etc \
            --disable-static  \
            --with-history    \
            --with-icu        \
            PYTHON=/usr/bin/python3 \
            --docdir=/usr/share/doc/libxml2-2.14.5

make
make install

rm -vf "$DESTDIR/usr/lib/libxml2.la"
sed '/libs=/s/xml2.*/xml2"/' -i "$DESTDIR/usr/bin/xml2-config"
