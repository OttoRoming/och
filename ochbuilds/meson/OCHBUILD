# name "meson"
# version "1.8.3"
# description "Open source build system designed to be both extremely fast and as user friendly as possible."
# url "https://mesonbuild.com/"
# source tar "https://github.com/mesonbuild/meson/releases/download/1.8.3/meson-1.8.3.tar.gz"
# ---

cd meson-1.8.3

pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"

pip3 install --root="$DESTDIR" --no-index --find-links dist meson
install -vDm644 data/shell-completions/bash/meson "$DESTDIR/usr/share/bash-completion/completions/meson"
install -vDm644 data/shell-completions/zsh/_meson "$DESTDIR/usr/share/zsh/site-functions/_meson"
