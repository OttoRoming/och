# name "openssl"
# version "3.5.2"
# description "management tools and libraries relating to cryptography"
# url "https://www.openssl-library.org/"
# source tar "https://github.com/openssl/openssl/releases/download/openssl-3.5.2/openssl-3.5.2.tar.gz"
# ---

cd openssl-3.5.2

./config --prefix=/usr         \
         --openssldir=/etc/ssl \
         --libdir=lib          \
         shared                \
         zlib-dynamic

make

sed -i '/INSTALL_LIBS/s/libcrypto.a libssl.a//' Makefile
make MANSUFFIX=ssl install

mv -v "$DESTDIR/usr/share/doc/openssl" "$DESTDIR/usr/share/doc/openssl-3.5.2"
cp -vfr doc/* "$DESTDIR/usr/share/doc/openssl-3.5.2"
