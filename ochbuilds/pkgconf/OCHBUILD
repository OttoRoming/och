# name "pkgconf"
# version "2.5.1"
# description "Successor to pkg-config and contains a tool for passing the include path and/or library paths to build tools during the configure and make phases of package installations. "
# url "https://github.com/pkgconf/pkgconf"
# source tar "https://distfiles.ariadne.space/pkgconf/pkgconf-2.5.1.tar.xz"
# ---

cd pkgconf-2.5.1

./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/pkgconf-2.5.1

make
make install

# To maintain compatibility with the original Pkg-config create two symlinks
ln -sv pkgconf   "$DESTDIR/usr/bin/pkg-config"
ln -sv pkgconf.1 "$DESTDIR/usr/share/man/man1/pkg-config.1"
