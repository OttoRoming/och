# name "python-editables"
# version "0.5"
# description "This library supports the building of wheels which, when installed, will expose packages in a local directory on sys.path in editable mode"
# url "https://github.com/pfmoore/editables"
# source tar "https://files.pythonhosted.org/packages/source/e/editables/editables-0.5.tar.gz"
# ---

cd editables-0.5

pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
pip3 install --root="$DESTDIR" --no-index --find-links dist editables
