# name "readline"
# version "8.3"
# description "A set of libraries that offer command-line editing and history capabilities."
# url "https://tiswww.case.edu/php/chet/readline/rltop.html"
# source tar "https://ftp.gnu.org/gnu/readline/readline-8.3.tar.gz"
# ---

cd readline-8.3

# Prevent hard coding library search paths (rpath) into the shared libraries.
# This package does not need rpath for an installation into the standard location,
# and rpath may sometimes cause unwanted effects or even security issues
sed -i 's/-Wl,-rpath,[^ ]*//' support/shobj-conf

./configure --prefix=/usr    \
            --disable-static \
            --with-curses    \
            --docdir=/usr/share/doc/readline-8.3

make SHLIB_LIBS="-lncursesw"
make install
install -v -m644 doc/*.{ps,pdf,html,dvi} "$DESTDIR/usr/share/doc/readline-8.3"
